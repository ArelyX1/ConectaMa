    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./src/assets/fonts/SignikaNegative-Regular.ttf"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "00acd416-7bd8-42c6-853a-7a7281e76f89"
